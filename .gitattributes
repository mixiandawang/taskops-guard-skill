# 统一换行符：仓库内存 LF，检出到 Windows 时自动转 CRLF
* text=auto eol=lf

# Markdown 与脚本一律 LF（避免 diff 全文件飘红）
*.md    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf

# 明确标记为二进制，防止被当文本改动
*.png   binary
*.jpg   binary
*.gif   binary
*.pdf   binary
*.zip   binary

# 让 GitHub/Gitee 正确识别中文文本文件、不误判为二进制
*.md    diff=markdown
